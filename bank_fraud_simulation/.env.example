# Local simulation settings. Never use the demo database or demo accounts in production.
FLASK_ENV=development
FLASK_DEBUG=false
DEMO_MODE=true
AUTO_CREATE_DB=true
PUBLIC_REGISTRATION_ENABLED=true
# Leave blank to use backend/instance/bank_fraud_simulation.db.
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
REDIS_URL=memory://
TRUSTED_PROXY_COUNT=0
SMS_MODE=simulation
SMS_DEFAULT_COUNTRY_CODE=91

# Set SMS_MODE=msg91 only after MSG91 approves the sender/template.
# Configure the approved MSG91 Flow template with a variable mapped to VAR1.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Leave blank for development-only fallback keys. Production requires two distinct
# random values of at least 32 characters, supplied through the deployment secret store.
SECRET_KEY=
JWT_SECRET_KEY=
